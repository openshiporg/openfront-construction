{
  "name": "weekday-keystone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "keystone build --no-ui && npm run migrate && next dev",
    "build": "keystone build --no-ui && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:schema": "eslint features/keystone/access.ts features/keystone/index.ts features/keystone/domain features/keystone/models features/keystone/mutations features/platform/assistant features/keystone/mcp app/api/completion/route.ts 'app/api/mcp-transport/[transport]/route.ts' tests/schema tests/security --max-warnings=0",
    "test": "npm run test:schema && npm run test:security",
    "test:schema": "tsx --test tests/schema/*.test.ts tests/schema/*.test.mjs",
    "test:security": "tsx --test tests/security/*.test.ts",
    "proof:authorization": "tsx tests/integration/authorization-proof.ts",
    "proof:workflows": "tsx tests/integration/operational-workflow-proof.ts",
    "typecheck": "tsc --noEmit",
    "outbox:work": "tsx features/keystone/outbox/run.ts",
    "migrate:gen": "keystone build --no-ui && tsx features/keystone/view-order/generate-view-order.ts && keystone prisma migrate dev",
    "migrate": "prisma migrate deploy"
  },
