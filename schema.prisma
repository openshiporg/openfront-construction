model ServiceRequest {
  id               String                   @id @default(cuid())
  reference        String                   @unique @default("")
  requestKey       String                   @unique @default("")
  requestDigest    String                   @default("")
  serviceTitle     String                   @default("")
  serviceSlug      String                   @default("")
  scope            String                   @default("")
  status           ServiceRequestStatusType @default(requested)
  version          Int                      @default(0)
  currencyCode     String                   @default("USD")
  quoteMinor       BigInt                   @default(0)
  quoteTerms       String                   @default("")
  expiresAt        DateTime?
  acceptedAt       DateTime?
  acceptedSnapshot Json?
  customer         User?                    @relation("ServiceRequest_customer", fields: [customerId], references: [id])
  customerId       String?                  @map("customer")
  company          Company?                 @relation("ServiceRequest_company", fields: [companyId], references: [id])
  companyId        String?                  @map("company")
  service          PublicService?           @relation("ServiceRequest_service", fields: [serviceId], references: [id])
  serviceId        String?                  @map("service")
  events           ServiceRequestEvent[]    @relation("ServiceRequestEvent_request")
  createdByUser    User?                    @relation("ServiceRequest_createdByUser", fields: [createdByUserId], references: [id])
  createdByUserId  String?                  @map("createdByUser")
  updatedByUser    User?                    @relation("ServiceRequest_updatedByUser", fields: [updatedByUserId], references: [id])
  updatedByUserId  String?                  @map("updatedByUser")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt

  @@index([customerId])
  @@index([companyId])
  @@index([serviceId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model ServiceRequestEvent {
  id              String          @id @default(cuid())
  eventKey        String          @unique @default("")
  commandDigest   String          @default("")
  action          String          @default("")
  fromStatus      String          @default("")
  toStatus        String          @default("")
  version         Int?
  snapshot        Json?
  actor           User?           @relation("ServiceRequestEvent_actor", fields: [actorId], references: [id])
  actorId         String?         @map("actor")
  request         ServiceRequest? @relation("ServiceRequestEvent_request", fields: [requestId], references: [id])
  requestId       String?         @map("request")
  createdByUser   User?           @relation("ServiceRequestEvent_createdByUser", fields: [createdByUserId], references: [id])
  createdByUserId String?         @map("createdByUser")
  updatedByUser   User?           @relation("ServiceRequestEvent_updatedByUser", fields: [updatedByUserId], references: [id])
  updatedByUserId String?         @map("updatedByUser")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([actorId])
  @@index([requestId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

